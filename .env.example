# JIS – Judiciary Info System
# Copy this file to .env and fill in your values.

PORT=3000
SESSION_SECRET=jis_change_this_secret_in_production

DB_HOST=localhost
# Default MySQL port (use 3307 for local Docker/containerized MySQL or 3306 for standard MySQL)
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=jis_db

# Dedicated isolated test database (used when NODE_ENV=test)
TEST_DB_NAME=jis_test_db
