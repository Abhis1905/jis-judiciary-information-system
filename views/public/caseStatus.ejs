<%- include('../partials/header', { title: `Case ${caseRecord.case_number} – JIS` }) %>

<%
  const hearingsList = typeof allHearings !== 'undefined' && allHearings ? allHearings : [];
  const stages = ['Filed', 'Allocated', 'In Trial', 'Judgement Pending', 'Closed'];
  const stageIdx = stages.indexOf(caseRecord.status);
%>

<div class="container py-4">

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Public Case Search</a></li>
      <li class="breadcrumb-item active" aria-current="page">Case <%= caseRecord.case_number %></li>
    </ol>
  </nav>

  <!-- 1. CASE HEADER -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-dark text-white py-3 px-4">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <code class="text-warning fw-bold fs-6"><%= caseRecord.case_number %></code>
            <span class="badge bg-secondary-subtle text-light border border-secondary">Public Docket Record</span>
          </div>
          <h1 class="h4 mb-0 fw-bold text-white"><%= caseRecord.title %></h1>
        </div>
        <span class="badge fs-6 px-3 py-2 bg-<%= caseRecord.status === 'Closed' ? 'secondary' : caseRecord.status === 'In Trial' ? 'warning text-dark' : caseRecord.status === 'Judgement Pending' ? 'danger' : 'info text-dark' %>">
          <%= caseRecord.status %>
        </span>
      </div>
    </div>

    <!-- 2. CASE OVERVIEW -->
    <div class="card-body p-4">
      <h2 class="h6 text-uppercase text-muted fw-bold mb-3" style="letter-spacing: 0.04em;">
        Case Overview
      </h2>
      <div class="row g-3">
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border bg-light h-100">
            <div class="text-muted small mb-1">Case Type</div>
            <div class="fw-bold text-dark"><%= caseRecord.case_type %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border bg-light h-100">
            <div class="text-muted small mb-1">Filing Date</div>
            <div class="fw-bold text-dark">
              <%= caseRecord.filing_date ? new Date(caseRecord.filing_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border bg-light h-100">
            <div class="text-muted small mb-1">Forum / Court Level</div>
            <div class="fw-bold text-dark"><%= caseRecord.court_level_name || 'District & Subordinate Court' %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border bg-light h-100">
            <div class="text-muted small mb-1">Next Scheduled Hearing</div>
            <div class="fw-bold <%= nextHearing ? 'text-primary' : 'text-muted' %>">
              <% if (nextHearing) { %>
                <%= new Date(nextHearing.hearing_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                (<%= nextHearing.hearing_time.slice(0, 5) %>)
              <% } else { %>
                <%= caseRecord.status === 'Closed' ? 'Case Disposed' : 'Not Scheduled' %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. PARTIES (Petitioner & Respondent) -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-people text-primary me-2"></i>Parties to the Case
      </h2>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="p-3 rounded-3 border bg-light h-100">
            <div class="text-uppercase text-primary fw-bold small mb-1" style="letter-spacing: 0.04em;">
              Petitioner / Complainant / Appellant
            </div>
            <div class="fs-6 fw-bold text-dark"><%= caseRecord.petitioner_name %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3 border bg-light h-100">
            <div class="text-uppercase text-secondary fw-bold small mb-1" style="letter-spacing: 0.04em;">
              Respondent / Accused / Defendant
            </div>
            <div class="fs-6 fw-bold text-dark"><%= caseRecord.respondent_name %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. CASE DESCRIPTION / FACTS -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-file-text text-primary me-2"></i>Case Description &amp; Factual Summary
      </h2>
    </div>
    <div class="card-body p-4">
      <% if (caseRecord.description && caseRecord.description.trim()) { %>
        <p class="jis-prose text-secondary mb-0"><%= caseRecord.description %></p>
      <% } else { %>
        <p class="text-muted small mb-0">No detailed factual summary has been published for this public case record.</p>
      <% } %>
    </div>
  </div>

  <!-- 5. COURT & JURISDICTION (Primary summary + collapsible technical hierarchy) -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-bank text-primary me-2"></i>Court &amp; Jurisdiction
      </h2>
      <% if (caseRecord.state_name) { %>
        <span class="badge bg-light text-dark border"><%= caseRecord.state_name %></span>
      <% } %>
    </div>
    <div class="card-body p-4">
      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <div class="small text-muted">Presiding Establishment</div>
          <div class="fw-semibold text-dark">
            <%= caseRecord.subordinate_court_name || caseRecord.high_court_name || caseRecord.court_level_name || 'Principal Court' %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="small text-muted">Judicial District &amp; State</div>
          <div class="fw-semibold text-dark">
            <%= caseRecord.district_name ? caseRecord.district_name + ', ' : '' %><%= caseRecord.state_name || 'All-India Jurisdiction' %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="small text-muted">Appellate High Court &amp; Bench</div>
          <div class="fw-semibold text-dark">
            <%= caseRecord.high_court_name || 'Supreme Court / High Court' %><%= caseRecord.bench_name ? ' (' + caseRecord.bench_name + ')' : '' %>
          </div>
        </div>
      </div>

      <!-- Collapsible full 6-step hierarchy & statutory escalation pathway -->
      <details class="pt-2 border-top">
        <summary class="small fw-semibold text-primary" style="cursor: pointer;">
          View Complete 6-Tier Judicial Hierarchy &amp; Statutory Appellate Pathway
        </summary>
        <div class="mt-3">
          <%- include('../partials/jurisdictionInfo') %>
        </div>
      </details>
    </div>
  </div>

  <!-- 6. CURRENT STATUS (Case Progress Stepper) -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-arrow-right-circle text-primary me-2"></i>Current Status &amp; Case Stage
      </h2>
      <span class="badge bg-light text-dark border">Current Stage: <strong><%= caseRecord.status %></strong></span>
    </div>
    <div class="card-body p-4">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <% stages.forEach((stage, i) => { %>
          <div class="text-center" style="min-width: 90px;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center border border-2
                        <%= i <= stageIdx ? 'bg-primary text-white border-primary' : 'text-muted border-secondary' %>"
                 style="width: 2.3rem; height: 2.3rem; font-size: 0.8rem;">
              <% if (i < stageIdx) { %><i class="bi bi-check-lg"></i>
              <% } else if (i === stageIdx) { %>&#9679;
              <% } else { %><%= i + 1 %><% } %>
            </div>
            <div class="small mt-1 <%= i <= stageIdx ? 'fw-semibold text-dark' : 'text-muted' %>"
                 style="font-size: 0.78rem;"><%= stage %></div>
          </div>
          <% if (i < stages.length - 1) { %>
            <div class="flex-grow-1 border-top border-2 d-none d-sm-block
                        <%= i < stageIdx ? 'border-primary' : 'border-secondary border-opacity-25' %>"
                 style="min-width: 1rem;"></div>
          <% } %>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- 7. HEARING TIMELINE -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-calendar-week text-primary me-2"></i>Hearing Timeline (<%= hearingsList.length %>)
      </h2>
      <% if (nextHearing) { %>
        <span class="badge bg-info-subtle text-dark border">
          Next Hearing: <%= new Date(nextHearing.hearing_date).toLocaleDateString('en-IN') %> at <%= nextHearing.hearing_time.slice(0, 5) %>
        </span>
      <% } %>
    </div>
    <div class="card-body p-4">
      <% if (hearingsList.length === 0) { %>
        <div class="p-3 rounded border bg-light text-muted small">
          <i class="bi bi-calendar-x me-1"></i>No public hearing dates have been recorded for this case yet.
        </div>
      <% } else { %>
        <div class="table-responsive border rounded">
          <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Hearing Date</th>
                <th>Time</th>
                <th>Stage / Hearing Type</th>
                <th>Court Room</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% hearingsList.forEach(function(h) { %>
                <tr>
                  <td class="fw-semibold text-dark">
                    <%= new Date(h.hearing_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </td>
                  <td><%= h.hearing_time ? h.hearing_time.slice(0, 5) : '—' %></td>
                  <td><%= h.hearing_type || 'Hearing' %></td>
                  <td><%= h.court_room || 'Assigned Courtroom' %></td>
                  <td>
                    <span class="badge bg-<%= h.status === 'Completed' ? 'success-subtle text-success border border-success-subtle' : h.status === 'Postponed' ? 'warning-subtle text-dark border' : 'primary-subtle text-primary border' %>">
                      <%= h.status %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 8. APPLICABLE ACTS & SECTIONS + 9. RELATED / PRECEDENT JUDGMENTS (REAL_VERIFIED only) -->
  <%- include('../partials/caseLegalPanel') %>

  <!-- 10. APPEAL HISTORY -->
  <%- include('../partials/appealHistory') %>

  <!-- 11. FINAL JUDGMENT -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-gavel text-primary me-2"></i>Final Judgment &amp; Verdict
      </h2>
    </div>
    <div class="card-body p-4">
      <% if (judgement) { %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <span class="text-muted small d-block">Final Verdict</span>
            <span class="badge fs-6 mt-1 bg-<%= judgement.verdict === 'Guilty' ? 'danger' : judgement.verdict === 'Not Guilty' ? 'success' : 'secondary' %>">
              <%= judgement.verdict %>
            </span>
          </div>
          <div class="text-muted small">
            <i class="bi bi-calendar-check me-1"></i>
            <strong>Judgment Date:</strong> <%= new Date(judgement.judgement_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
          </div>
        </div>
        <div class="p-3 rounded-3 border bg-light">
          <div class="small fw-bold text-dark text-uppercase mb-1">Operative Summary</div>
          <p class="jis-prose text-secondary mb-0"><%= judgement.summary %></p>
        </div>
      <% } else { %>
        <div class="p-3 rounded border bg-light text-muted small">
          <i class="bi bi-hourglass-split me-1"></i>
          Final judgment has not yet been pronounced. Current case status is <strong><%= caseRecord.status %></strong>.
        </div>
      <% } %>
    </div>
  </div>

  <!-- 12. DOWNLOAD JUDGMENT PDF (Graceful handling when no verified PDF exists) -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
      <h2 class="jis-section-title mb-0">
        <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Judgment Document (PDF)
      </h2>
    </div>
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 rounded-3 border bg-light">
        <div>
          <div class="fw-semibold text-dark mb-1">
            Judgment document unavailable
          </div>
          <p class="small text-muted mb-0">
            No signed full-text judgment PDF is archived for this docket record (synthetic simulation case <code><%= caseRecord.case_number %></code>). To view or download verified full-text Supreme Court judgment PDFs, visit the <a href="/legal" class="text-primary fw-semibold">Legal Knowledge Repository</a>.
          </p>
        </div>
        <a href="/legal" class="btn btn-outline-primary btn-sm fw-semibold flex-shrink-0">
          Browse Verified Judgment PDFs &rarr;
        </a>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
