<%- include('../partials/header', { title: 'Judge Dashboard – JIS' }) %>

<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold">
        <i class="bi bi-speedometer2 me-2 text-primary"></i>Judge Dashboard
      </h4>
      <p class="text-muted mb-0 small">Welcome, <%= user.full_name %></p>
    </div>
    <a href="/judge/cases" class="btn btn-dark">
      <i class="bi bi-briefcase me-1"></i>My Cases
    </a>
  </div>

  <!-- Stat Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-briefcase fs-2 text-primary d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= assignedCount %></h3>
          <p class="text-muted small mb-0">Assigned Cases</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-calendar-week fs-2 text-success d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= upcomingHearings.length %></h3>
          <p class="text-muted small mb-0">Hearings (next 7 days)</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-bell fs-2 text-danger d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= unreadCount %></h3>
          <p class="text-muted small mb-0">Unread Alerts</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
      <a href="/judge/cases" class="card border-0 shadow-sm text-decoration-none h-100">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi bi-briefcase fs-3 text-primary"></i>
          <div>
            <div class="fw-semibold">Assigned Cases</div>
            <div class="text-muted small">Trial updates · Notes · Judgements (J1–J2)</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6">
      <a href="/judge/precedents" class="card border-0 shadow-sm text-decoration-none h-100">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi bi-search fs-3 text-info"></i>
          <div>
            <div class="fw-semibold">Precedent Search</div>
            <div class="text-muted small">SC Judgement Repository (J3)</div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Upcoming Hearings -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold border-bottom">
      <i class="bi bi-calendar3 me-2 text-muted"></i>Upcoming Hearings (Next 7 Days)
    </div>
    <div class="card-body p-0">
      <% if (upcomingHearings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Case</th><th>Date</th><th>Time</th><th>Court Room</th><th>Type</th>
            </tr>
          </thead>
          <tbody>
            <% upcomingHearings.forEach(h => { %>
            <tr>
              <td>
                <a href="/judge/cases/<%= h.case_id %>" class="text-decoration-none fw-medium">
                  <%= h.case_title %>
                </a>
                <div class="text-muted small"><code><%= h.case_number %></code></div>
              </td>
              <td><%= new Date(h.hearing_date).toLocaleDateString('en-IN') %></td>
              <td><%= h.hearing_time.slice(0,5) %></td>
              <td><%= h.court_room || '—' %></td>
              <td><span class="badge bg-secondary"><%= h.hearing_type %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center text-muted py-4">
        <i class="bi bi-calendar-check fs-3 d-block mb-2"></i>No upcoming hearings in the next 7 days.
      </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
