<%- include('../partials/header', { title: 'Prosecutor Dashboard – JIS' }) %>

<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold">
        <i class="bi bi-speedometer2 me-2 text-primary"></i>Prosecutor Dashboard
      </h4>
      <p class="text-muted mb-0 small">Welcome, <%= user.full_name %></p>
    </div>
    <a href="/prosecutor/cases" class="btn btn-dark">
      <i class="bi bi-briefcase me-1"></i>My Cases
    </a>
  </div>

  <!-- Stat Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-folder2-open fs-2 text-primary d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= caseCount %></h3>
          <p class="text-muted small mb-0">Allocated Cases</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-calendar-week fs-2 text-success d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= upcomingHearings.length %></h3>
          <p class="text-muted small mb-0">Hearings (next 7 days)</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-bell fs-2 text-danger d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= unreadCount %></h3>
          <p class="text-muted small mb-0">Unread Alerts</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- Upcoming Hearing Notices (JIS → PUBLIC PROSECUTOR: Hearing Notices) -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold border-bottom d-flex justify-content-between align-items-center">
          <div>
            <i class="bi bi-calendar-event me-2 text-primary"></i>Upcoming Hearing Notices (Next 7 Days)
          </div>
          <span class="badge bg-secondary"><%= upcomingHearings.length %> Scheduled</span>
        </div>
        <div class="card-body p-0">
          <% if (upcomingHearings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Case</th><th>Date & Time</th><th>Court Room</th><th>Type</th>
                </tr>
              </thead>
              <tbody>
                <% upcomingHearings.forEach(h => { %>
                <tr>
                  <td>
                    <a href="/prosecutor/cases/<%= h.case_id %>" class="text-decoration-none fw-medium">
                      <%= h.case_title %>
                    </a>
                    <div class="text-muted small font-monospace"><%= h.case_number %></div>
                  </td>
                  <td>
                    <div class="fw-semibold"><%= new Date(h.hearing_date).toLocaleDateString('en-IN') %></div>
                    <div class="text-muted small"><%= h.hearing_time.slice(0,5) %></div>
                  </td>
                  <td><%= h.court_room || '—' %></td>
                  <td><span class="badge bg-secondary"><%= h.hearing_type %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-check fs-2 d-block mb-2"></i>No upcoming hearings scheduled.
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Recent Prosecution Updates -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold border-bottom">
          <i class="bi bi-chat-left-text me-2 text-primary"></i>Recent Prosecution Updates
        </div>
        <div class="card-body">
          <% if (typeof recentUpdates !== 'undefined' && recentUpdates.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% recentUpdates.forEach(u => { %>
              <div class="p-3 bg-light rounded border">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <a href="/prosecutor/cases/<%= u.case_id %>" class="text-decoration-none fw-semibold small">
                    <%= u.case_number %>
                  </a>
                  <span class="text-muted small"><%= new Date(u.created_at).toLocaleDateString('en-IN') %></span>
                </div>
                <p class="mb-0 text-secondary small text-truncate"><%= u.update_description %></p>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center text-muted py-5">
              <i class="bi bi-journal-text fs-2 d-block mb-2"></i>No recent status updates.
            </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>
