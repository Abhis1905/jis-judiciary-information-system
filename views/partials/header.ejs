<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'JIS – Judiciary Information System' %></title>

  <!-- Bootstrap 5.3.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous">

  <!-- Bootstrap Icons 1.11.3 -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- JIS Design System CSS (Variant A Base + Variant B Experiment) -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/variant-b.css">
  <script>
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        var qVar = params.get('variant');
        if (qVar === 'a' || qVar === 'b') {
          localStorage.setItem('jis_ui_variant', qVar);
          document.documentElement.setAttribute('data-jis-variant', qVar);
        } else {
          var saved = localStorage.getItem('jis_ui_variant');
          if (saved === 'b') {
            document.documentElement.setAttribute('data-jis-variant', 'b');
          } else {
            document.documentElement.setAttribute('data-jis-variant', 'a');
          }
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>

  <!-- Top Header -->
  <%- include('./navbar') %>

  <% if (user) { %>
    <!-- Authenticated Application Shell (Sidebar + Main Workspace) -->
    <div class="jis-shell">
      <%- include('./sidebar') %>

      <div class="jis-main-workspace">
        <main class="jis-main-content" id="mainContent">
          <% if (flash && flash.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
              <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
              <div><%= flash.error %></div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
          <% if (flash && flash.success) { %>
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
              <i class="bi bi-check-circle-fill flex-shrink-0"></i>
              <div><%= flash.success %></div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
  <% } else { %>
    <!-- Public Citizen Portal Layout -->
    <main class="jis-public-main pb-5" id="mainContent">
      <% if (flash && flash.error) { %>
        <div class="container mt-3">
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div><%= flash.error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% } %>
      <% if (flash && flash.success) { %>
        <div class="container mt-3">
          <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
            <div><%= flash.success %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% } %>
  <% } %>
