<%- include('../partials/header', { title: title }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 text-center">
      <div class="card border-0 shadow-sm py-5">
        <div class="card-body">
          <i class="bi bi-hourglass-split display-4 text-secondary mb-3 d-block"></i>
          <h5 class="fw-bold mb-2"><%= page %></h5>
          <p class="text-muted mb-1">This page will be fully implemented in <strong>Phase <%= phase %></strong>.</p>
          <p class="text-muted small">The route is registered and RBAC-protected.</p>
          <a href="javascript:history.back()" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i>Go Back
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
