<%- include('../partials/header', { title: 'Notifications – JIS' }) %>

<div class="container py-4">

  <!-- Header Row -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">
      <i class="bi bi-bell me-2 text-primary"></i>Notifications
    </h4>
    <% if (notifications.some(n => !n.is_read)) { %>
    <form action="/notifications/read-all" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-check2-all me-1"></i>Mark All as Read
      </button>
    </form>
    <% } %>
  </div>

  <!-- Notifications List -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if (notifications.length > 0) { %>
        <ul class="list-group list-group-flush">
          <% notifications.forEach(n => { %>
          <li class="list-group-item d-flex justify-content-between align-items-start py-3
                      <%= !n.is_read ? 'unread-item' : '' %>">
            <div class="flex-grow-1">
              <% if (!n.is_read) { %>
                <span class="badge bg-primary me-2 small">New</span>
              <% } %>
              <span class="<%= !n.is_read ? 'fw-semibold' : 'text-muted' %>">
                <%= n.message %>
              </span>
              <% if (n.case_title) { %>
              <div class="mt-1">
                <a href="/<%= user.role %>/cases/<%= n.case_id %>" class="text-decoration-none small text-muted">
                  <i class="bi bi-folder2 me-1"></i><%= n.case_number %> – <%= n.case_title %>
                </a>
              </div>
              <% } %>
              <div class="text-muted small mt-1">
                <i class="bi bi-clock me-1"></i>
                <%= new Date(n.created_at).toLocaleString('en-IN') %>
              </div>
            </div>
            <% if (!n.is_read) { %>
            <form action="/notifications/<%= n.id %>/read" method="POST" class="ms-3 flex-shrink-0">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary" title="Mark as read">
                <i class="bi bi-check2"></i>
              </button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-bell-slash fs-2 d-block mb-3"></i>
          No notifications yet.
        </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
