<%- include('../partials/header', { title: 'Advocate Dashboard – JIS' }) %>

<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold">
        <i class="bi bi-speedometer2 me-2 text-primary"></i>Advocate Dashboard
      </h4>
      <p class="text-muted mb-0 small">Welcome, <%= user.full_name %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/advocate/cases" class="btn btn-dark">
        <i class="bi bi-briefcase me-1"></i>My Cases
      </a>
      <a href="/advocate/causelist" class="btn btn-outline-dark">
        <i class="bi bi-list-ol me-1"></i>Cause List
      </a>
    </div>
  </div>

  <!-- Stat Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-briefcase fs-2 text-primary d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= caseCount %></h3>
          <p class="text-muted small mb-0">My Cases</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-calendar-today fs-2 text-success d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= todayHearings.length %></h3>
          <p class="text-muted small mb-0">Today's Hearings</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 shadow-sm text-center h-100 py-2">
        <div class="card-body">
          <i class="bi bi-bell fs-2 text-danger d-block mb-2"></i>
          <h3 class="fw-bold mb-0"><%= unreadCount %></h3>
          <p class="text-muted small mb-0">Unread Alerts</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
      <a href="/advocate/cases" class="card border-0 shadow-sm text-decoration-none h-100">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi bi-link-45deg fs-3 text-primary"></i>
          <div>
            <div class="fw-semibold">My Cases</div>
            <div class="text-muted small">Vakalatnama · E-Filings · Pleadings (A1–A2)</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6">
      <a href="/advocate/causelist" class="card border-0 shadow-sm text-decoration-none h-100">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi bi-list-ol fs-3 text-secondary"></i>
          <div>
            <div class="fw-semibold">Cause List</div>
            <div class="text-muted small">Upcoming hearings schedule (A3)</div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Today's Cause List (JIS → ADVOCATE: Cause Lists) -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold border-bottom">
      <i class="bi bi-list-ol me-2 text-muted"></i>Today's Cause List
    </div>
    <div class="card-body p-0">
      <% if (todayHearings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr><th>Case</th><th>Time</th><th>Court Room</th><th>Hearing Type</th></tr>
          </thead>
          <tbody>
            <% todayHearings.forEach(h => { %>
            <tr>
              <td>
                <a href="/advocate/cases/<%= h.case_id %>" class="text-decoration-none fw-medium">
                  <%= h.case_title %>
                </a>
                <div class="text-muted small"><code><%= h.case_number %></code></div>
              </td>
              <td><%= h.hearing_time.slice(0,5) %></td>
              <td><%= h.court_room || '—' %></td>
              <td><span class="badge bg-secondary"><%= h.hearing_type %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center text-muted py-4">
        <i class="bi bi-calendar-check fs-3 d-block mb-2"></i>No hearings scheduled for today.
      </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
