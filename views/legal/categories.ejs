<%- include('../partials/header') %>

<div class="container py-4">

  <!-- Header -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-2">
      <li class="breadcrumb-item"><a href="/legal" class="text-decoration-none">Legal Repository</a></li>
      <li class="breadcrumb-item active" aria-current="page">Legal Taxonomy</li>
    </ol>
  </nav>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">
        <i class="bi bi-tags-fill text-success me-2"></i>Legal Taxonomy & Subject Domains
      </h2>
      <p class="text-muted small mb-0">Structured classifications of Indian statutory provisions across civil, criminal, constitutional, and evidentiary jurisprudence.</p>
    </div>
    <span class="badge bg-success fs-6 px-3 py-2"><%= categories.length %> Subject Domains</span>
  </div>

  <!-- Category Cards Grid -->
  <div class="row g-4">
    <% categories.forEach(function(cat) { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4 d-flex flex-column">
            
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge bg-light text-dark border"><%= cat.domain %></span>
              <span class="badge bg-primary rounded-pill"><%= cat.section_count %> sections</span>
            </div>

            <h5 class="fw-bold text-dark mb-2">
              <a href="/legal/categories/<%= cat.id %>" class="text-decoration-none text-dark hover-primary">
                <%= cat.name %>
              </a>
            </h5>

            <p class="card-text text-secondary small mb-4 flex-grow-1">
              <%= cat.description %>
            </p>

            <div class="pt-3 border-top">
              <a href="/legal/categories/<%= cat.id %>" class="btn btn-outline-success btn-sm w-100 fw-semibold">
                Explore Categorized Provisions &rarr;
              </a>
            </div>

          </div>
        </div>
      </div>
    <% }); %>
  </div>

</div>

<%- include('../partials/footer') %>
