<%- include('../partials/header') %>

<div class="container py-4">

  <!-- Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><a href="/legal" class="text-decoration-none">Legal Repository</a></li>
          <li class="breadcrumb-item active" aria-current="page">Acts & Codes</li>
        </ol>
      </nav>
      <h2 class="fw-bold mb-0">Statutory Acts & Codes Library</h2>
      <p class="text-muted small mb-0">Browse major Indian statutes, historical criminal codes, and reformed 2023 criminal legislations.</p>
    </div>

    <!-- Status Filters -->
    <div class="d-flex gap-2 flex-wrap">
      <a href="/legal/acts" class="btn btn-sm <%= currentStatus === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">All Acts</a>
      <a href="/legal/acts?status=Active" class="btn btn-sm <%= currentStatus === 'Active' ? 'btn-success' : 'btn-outline-secondary' %>">Active</a>
      <a href="/legal/acts?status=Repealed%20%2F%20Historical" class="btn btn-sm <%= currentStatus === 'Repealed / Historical' ? 'btn-secondary' : 'btn-outline-secondary' %>">Repealed / Historical</a>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="card border-0 shadow-sm mb-4 p-3 bg-light">
    <form action="/legal/acts" method="GET" class="row g-2">
      <% if (currentStatus && currentStatus !== 'all') { %>
        <input type="hidden" name="status" value="<%= currentStatus %>">
      <% } %>
      <div class="col-md-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" value="<%= search %>" class="form-control border-start-0" placeholder="Filter acts by title, code or description...">
        </div>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100 fw-semibold">Filter</button>
      </div>
    </form>
  </div>

  <!-- Acts Grid -->
  <div class="row g-4">
    <% acts.forEach(function(act) { %>
      <div class="col-lg-6">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4 d-flex flex-column">
            
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge <%= act.status === 'Active' ? 'bg-success' : 'bg-secondary' %> px-2 py-1">
                <%= act.status %>
              </span>
              <span class="badge bg-light text-dark border">
                Enacted <%= act.enactment_year %>
              </span>
            </div>

            <h4 class="card-title fw-bold text-dark mb-1">
              <a href="/legal/acts/<%= act.id %>" class="text-decoration-none text-dark hover-primary">
                <%= act.short_title %>
              </a>
            </h4>
            <div class="text-muted small mb-3"><%= act.title %> &bull; <span class="fw-semibold text-dark"><%= act.act_number %></span></div>

            <p class="card-text text-secondary small mb-4 flex-grow-1">
              <%= act.description %>
            </p>

            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
              <div>
                <a href="<%= act.source_url %>" target="_blank" rel="noopener noreferrer" class="small text-decoration-none text-muted">
                  <i class="bi bi-box-arrow-up-right me-1"></i><%= act.source_name %>
                </a>
              </div>
              <a href="/legal/acts/<%= act.id %>" class="btn btn-primary btn-sm px-3 fw-semibold">
                Explore Sections <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>

          </div>
        </div>
      </div>
    <% }); %>
  </div>

</div>

<%- include('../partials/footer') %>
