<%- include('../partials/header') %>
<%- include('../partials/legalStyles') %>

<div class="jis-legal-scope">
  <!-- A. REPOSITORY OVERVIEW & UNIVERSAL RESEARCH BAR -->
  <section class="jis-legal-hero-banner py-5 mb-4 shadow-sm" aria-labelledby="legal-repo-heading">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-light border-opacity-25 small fw-semibold mb-3">
            <i class="bi bi-shield-check text-warning"></i>
            <span>Indian Statutory & Case Law Repository</span>
          </div>
          <h1 id="legal-repo-heading" class="display-6 fw-bold mb-2 text-white">
            Legal Knowledge Repository
          </h1>
          <p class="lead mb-4 text-light opacity-90" style="font-size: 1.02rem; max-width: 66ch;">
            An institutional judicial research portal providing structured access to <strong><%= stats.realJudgments %></strong> verified Indian judgments (<%= stats.realSupremeCourtJudgments %> Supreme Court and <%= stats.realHighCourtJudgments %> High Court decisions), <strong><%= stats.verifiedPdfCount || 11 %></strong> verified official Supreme Court full-text PDFs, <strong><%= stats.acts %></strong> major Acts, and <strong><%= stats.sections.toLocaleString('en-IN') %></strong> statutory sections.
          </p>

          <!-- Universal Research & Filter Form -->
          <form action="/legal/search" method="GET" class="bg-white text-dark p-3 rounded-3 shadow" role="search" aria-label="Search Legal Knowledge Repository">
            <div class="input-group mb-2">
              <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="text"
                name="q"
                class="form-control border-start-0 shadow-none"
                placeholder="Search by case title, citation, case number, legal issue, ratio, or section (e.g. 'Puttaswamy', '(2017) 10 SCC 1', 'Article 21', '302')..."
                aria-label="Search query"
              >
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                Search Repository
              </button>
            </div>

            <div class="row g-2 pt-1">
              <div class="col-sm-6 col-md-3">
                <select name="court_tier" class="form-select form-select-sm" aria-label="Filter by Court Level">
                  <option value="">All Verified Courts (<%= stats.realJudgments %>)</option>
                  <option value="Supreme Court of India">Supreme Court (<%= stats.realSupremeCourtJudgments %>)</option>
                  <option value="High Court">High Courts (<%= stats.realHighCourtJudgments %>)</option>
                </select>
              </div>
              <div class="col-sm-6 col-md-4">
                <select name="domain" class="form-select form-select-sm" aria-label="Filter by Legal Domain">
                  <option value="">All Legal Categories</option>
                  <% if (typeof domains !== 'undefined' && domains) { %>
                    <% domains.forEach(function(d) { %>
                      <option value="<%= d %>"><%= d %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="col-sm-6 col-md-2">
                <select name="year" class="form-select form-select-sm" aria-label="Filter by Year">
                  <option value="">All Years</option>
                  <% if (typeof years !== 'undefined' && years) { %>
                    <% years.forEach(function(yr) { %>
                      <option value="<%= yr %>"><%= yr %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="col-sm-6 col-md-3">
                <select name="pdf_only" class="form-select form-select-sm" aria-label="Filter by PDF Availability">
                  <option value="">All Verified Records</option>
                  <option value="1">Verified PDF Available (<%= stats.verifiedPdfCount || 11 %>)</option>
                </select>
              </div>
            </div>
          </form>
        </div>

        <!-- A. Repository Overview Statistics Panel -->
        <div class="col-lg-5">
          <div class="card bg-white text-dark shadow border-0 p-3">
            <div class="card-body p-2">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 text-uppercase text-muted fw-bold mb-0" style="letter-spacing: 0.04em;">
                  A. Repository Overview
                </h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  <i class="bi bi-patch-check-fill me-1"></i>REAL / VERIFIED
                </span>
              </div>

              <div class="jis-legal-stat-grid">
                <div class="jis-legal-stat-tile">
                  <div class="jis-legal-stat-value text-primary"><%= stats.realJudgments %></div>
                  <div class="jis-legal-stat-label">Total Verified Judgments</div>
                  <div class="jis-legal-stat-sub">Authentic published precedents</div>
                </div>
                <div class="jis-legal-stat-tile">
                  <div class="jis-legal-stat-value text-dark"><%= stats.realSupremeCourtJudgments %></div>
                  <div class="jis-legal-stat-label">Supreme Court</div>
                  <div class="jis-legal-stat-sub">Article 141 binding rulings</div>
                </div>
                <div class="jis-legal-stat-tile">
                  <div class="jis-legal-stat-value text-dark"><%= stats.realHighCourtJudgments %></div>
                  <div class="jis-legal-stat-label">High Courts</div>
                  <div class="jis-legal-stat-sub">State appellate &amp; writ rulings</div>
                </div>
                <div class="jis-legal-stat-tile">
                  <div class="jis-legal-stat-value text-success"><%= stats.verifiedPdfCount || 11 %></div>
                  <div class="jis-legal-stat-label">Judgments with Verified PDF</div>
                  <div class="jis-legal-stat-sub">Full-text SHA-256 verified PDFs</div>
                </div>
              </div>

              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top small text-secondary">
                <span><strong><%= stats.acts %></strong> Acts &amp; Codes</span>
                <span>&bull;</span>
                <span><strong><%= stats.sections.toLocaleString('en-IN') %></strong> Sections</span>
                <span>&bull;</span>
                <span><strong><%= stats.relations %></strong> IPC/BNS Mappings</span>
              </div>

              <div class="mt-2 pt-2 border-top text-muted" style="font-size: 0.73rem; line-height: 1.4;">
                <i class="bi bi-check2-circle text-success me-1"></i>
                Public repository views exclusively expose <strong>REAL / VERIFIED</strong> judicial decisions; internal <span>SYNTHETIC / REPRESENTATIVE</span> records are excluded from public listings.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container mb-5">
    <!-- Section Jump Bar -->
    <nav aria-label="Repository section navigation" class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 mb-4 bg-white border rounded-3 shadow-sm">
      <div class="d-flex flex-wrap gap-2">
        <a href="#section-featured" class="btn btn-sm btn-light border fw-semibold">
          <i class="bi bi-award-fill me-1 text-warning"></i>B. Featured / Landmark Decisions
        </a>
        <a href="#section-recent" class="btn btn-sm btn-light border fw-semibold">
          <i class="bi bi-clock-history me-1 text-primary"></i>C. Recent Verified Judgments
        </a>
        <a href="#section-courts" class="btn btn-sm btn-light border fw-semibold">
          <i class="bi bi-bank me-1 text-dark"></i>D. Browse by Court (<%= stats.realJudgments %>)
        </a>
        <a href="#section-research" class="btn btn-sm btn-light border fw-semibold">
          <i class="bi bi-book me-1 text-success"></i>E. Search &amp; Statutory Research
        </a>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/legal/search?pdf_only=1" class="btn btn-sm btn-outline-success fw-semibold">
          <i class="bi bi-file-earmark-pdf-fill me-1"></i>Verified PDFs (<%= stats.verifiedPdfCount || 11 %>)
        </a>
        <a href="/legal/mapping" class="btn btn-sm btn-dark fw-semibold">
          <i class="bi bi-arrow-left-right me-1"></i>IPC / BNS Transition Matrix
        </a>
      </div>
    </nav>

    <!-- B. FEATURED / LANDMARK DECISIONS -->
    <section id="section-featured" class="mb-5" aria-labelledby="heading-featured">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3 gap-2 border-bottom pb-2">
        <div>
          <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 0.05em;">
            Section B &middot; Foundational Constitutional &amp; Criminal Precedents
          </span>
          <h2 id="heading-featured" class="h3 fw-bold mb-1">Featured / Landmark Decisions</h2>
          <p class="text-muted small mb-0">
            Landmark Supreme Court rulings with comprehensive case summaries, legal issues, binding ratio decidendi, and verified full-text PDF documents.
          </p>
        </div>
        <a href="/legal/judgments/supreme-court" class="btn btn-sm btn-primary fw-semibold flex-shrink-0">
          Explore All <%= stats.realSupremeCourtJudgments %> Supreme Court Judgments &rarr;
        </a>
      </div>

      <div class="row g-4">
        <% recentLandmarks.forEach(function(j) { %>
          <div class="col-lg-6">
            <%- include('../partials/judgmentCard', { j }) %>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- C. RECENT VERIFIED JUDGMENTS -->
    <section id="section-recent" class="mb-5 pt-2" aria-labelledby="heading-recent">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3 gap-2 border-bottom pb-2">
        <div>
          <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 0.05em;">
            Section C &middot; Chronological Judicial Decisions
          </span>
          <h2 id="heading-recent" class="h3 fw-bold mb-1">Recent Verified Judgments</h2>
          <p class="text-muted small mb-0">
            The most recent verified rulings across the Supreme Court of India and State High Courts ordered by judgment date.
          </p>
        </div>
        <a href="/legal/search?landmark=1" class="btn btn-sm btn-outline-primary fw-semibold flex-shrink-0">
          Search All <%= stats.realJudgments %> Verified Judgments &rarr;
        </a>
      </div>

      <div class="row g-4">
        <% (typeof recentVerifiedJudgments !== 'undefined' && recentVerifiedJudgments ? recentVerifiedJudgments : scJudgments).slice(0, 6).forEach(function(j) { %>
          <div class="col-lg-6">
            <%- include('../partials/judgmentCard', { j }) %>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- D. BROWSE BY COURT -->
    <section id="section-courts" class="mb-5 pt-2" aria-labelledby="heading-browse-courts">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3 gap-2 border-bottom pb-2">
        <div>
          <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 0.05em;">
            Section D &middot; Judicial Hierarchy Repositories
          </span>
          <h2 id="heading-browse-courts" class="h3 fw-bold mb-1">Browse by Court</h2>
          <p class="text-muted small mb-0">
            Navigate verified precedents by judicial forum: Apex Court constitutional/appellate rulings (<%= stats.realSupremeCourtJudgments %>) and State High Court judgments (<%= stats.realHighCourtJudgments %>).
          </p>
        </div>
      </div>

      <!-- Court Tier Overview Cards -->
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="card border shadow-sm h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                  <span class="badge bg-dark text-white px-2 py-1">
                    <i class="bi bi-award-fill text-warning me-1"></i>Apex Court (Article 141)
                  </span>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                    <%= stats.realSupremeCourtJudgments %> Verified Judgments
                  </span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">Supreme Court of India</h3>
                <p class="small text-secondary mb-3">
                  Constitutional bench rulings, criminal procedure guidelines, fundamental rights jurisprudence, and statutory interpretations binding on all courts within the territory of India. Includes <strong><%= stats.verifiedPdfCount || 11 %></strong> judgments with locally archived official PDFs.
                </p>
              </div>
              <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a href="/legal/judgments/supreme-court" class="btn btn-primary btn-sm fw-semibold px-3">
                  Browse Supreme Court (<%= stats.realSupremeCourtJudgments %>) &rarr;
                </a>
                <a href="/legal/judgments/supreme-court?pdf_only=1" class="btn btn-outline-dark btn-sm fw-semibold">
                  <i class="bi bi-file-earmark-pdf text-danger me-1"></i>With Full PDF (<%= stats.verifiedPdfCount || 11 %>)
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border shadow-sm h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                  <span class="badge bg-dark text-white px-2 py-1">
                    <i class="bi bi-building text-info me-1"></i>State Appellate &amp; Writ Courts (Article 226)
                  </span>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                    <%= stats.realHighCourtJudgments %> Verified Judgments
                  </span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">High Courts of India</h3>
                <p class="small text-secondary mb-3">
                  Verified judgments from Delhi, Bombay, Allahabad, Calcutta, Madras, Kerala, and Karnataka High Courts covering writ jurisdiction, criminal appeals, commercial disputes, and constitutional questions.
                </p>
              </div>
              <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a href="/legal/judgments/high-courts" class="btn btn-primary btn-sm fw-semibold px-3">
                  Browse High Courts (<%= stats.realHighCourtJudgments %>) &rarr;
                </a>
                <a href="/legal/search?court_tier=High+Court" class="btn btn-outline-secondary btn-sm fw-semibold">
                  Filter by High Court &amp; Domain
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- High Court Preview Cards -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h5 fw-bold mb-0">Selected High Court Decisions (<%= stats.realHighCourtJudgments %> Total Available)</h3>
        <a href="/legal/judgments/high-courts" class="small fw-semibold text-primary text-decoration-none">
          View All <%= stats.realHighCourtJudgments %> High Court Judgments &rarr;
        </a>
      </div>
      <div class="row g-4">
        <% (hcJudgments || []).slice(0, 4).forEach(function(j) { %>
          <div class="col-lg-6">
            <%- include('../partials/judgmentCard', { j }) %>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- E. SEARCH / STATUTORY RESEARCH -->
    <section id="section-research" class="mb-4 pt-2" aria-labelledby="heading-statutory-research">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-3 gap-2 border-bottom pb-2">
        <div>
          <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 0.05em;">
            Section E &middot; Statutory Codes, Provisions &amp; Subject Taxonomy
          </span>
          <h2 id="heading-statutory-research" class="h3 fw-bold mb-1">Search &amp; Statutory Research</h2>
          <p class="text-muted small mb-0">
            Cross-reference judicial precedents with the 10 enacted Indian Acts, <%= stats.sections.toLocaleString('en-IN') %> statutory sections, and the 1 July 2024 Criminal Sanhita transition matrix.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/legal/search" class="btn btn-sm btn-primary fw-semibold">
            <i class="bi bi-search me-1"></i>Advanced Legal Search
          </a>
          <a href="/legal/mapping" class="btn btn-sm btn-dark fw-semibold">
            <i class="bi bi-arrow-left-right me-1"></i>Old &harr; New Law Matrix (<%= stats.relations %>)
          </a>
          <a href="/legal/acts" class="btn btn-sm btn-outline-primary fw-semibold">
            Explore All <%= stats.acts %> Acts &rarr;
          </a>
        </div>
      </div>

      <!-- Enacted Legislation Table -->
      <div class="card border shadow-sm mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h3 class="h6 fw-bold mb-0">Statutory Acts &amp; Codes Library (<%= stats.acts %>)</h3>
          <span class="small text-muted">Active Sanhitas &amp; Historical Codes</span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Act / Code Title</th>
                <th>Year / Act No.</th>
                <th>Status</th>
                <th>Enforcement Date</th>
                <th>Official Source</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% acts.forEach(function(act) { %>
                <tr>
                  <td>
                    <div class="fw-bold">
                      <a href="/legal/acts/<%= act.id %>" class="text-decoration-none text-dark hover-primary"><%= act.short_title %></a>
                    </div>
                    <div class="small text-muted"><%= act.title %></div>
                  </td>
                  <td class="small fw-medium"><%= act.act_number || act.enactment_year %></td>
                  <td>
                    <% if (act.status === 'Active') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    <% } else if (act.status === 'Repealed / Historical') { %>
                      <span class="badge bg-secondary-subtle text-secondary border">Historical (Pre-1 July 2024)</span>
                    <% } else { %>
                      <span class="badge bg-warning-subtle text-dark border"><%= act.status %></span>
                    <% } %>
                  </td>
                  <td class="small text-muted">
                    <%= act.enforcing_date ? new Date(act.enforcing_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>
                  </td>
                  <td>
                    <a href="<%= act.source_url %>" target="_blank" rel="noopener noreferrer" class="small text-decoration-none text-muted">
                      <%= act.source_type %> <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                  </td>
                  <td class="text-end">
                    <a href="/legal/acts/<%= act.id %>" class="btn btn-sm btn-outline-primary fw-semibold">
                      Browse Sections
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Key Statutory Sections & Subject Domains -->
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card border shadow-sm h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
              <h3 class="h6 fw-bold mb-0">Frequently Cited Constitutional &amp; Statutory Provisions</h3>
              <a href="/legal/acts" class="small fw-semibold text-primary text-decoration-none">All <%= stats.sections.toLocaleString('en-IN') %> Sections &rarr;</a>
            </div>
            <div class="card-body p-3">
              <div class="row g-2">
                <% (featuredSections || []).forEach(function(sec) { %>
                  <div class="col-sm-6">
                    <div class="p-2 px-3 border rounded bg-light h-100 d-flex flex-column justify-content-between">
                      <div>
                        <div class="d-flex justify-content-between align-items-center gap-1 mb-1">
                          <span class="badge bg-white text-dark border" style="font-size: 0.68rem;"><%= sec.act_short_title %></span>
                          <span class="badge <%= sec.status === 'Active' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border' %>" style="font-size: 0.65rem;">
                            <%= sec.status %>
                          </span>
                        </div>
                        <div class="small fw-bold">
                          <a href="/legal/sections/<%= sec.id %>" class="text-decoration-none text-dark">
                            <%= sec.act_code === 'CONST_1950' ? sec.section_number : 'Sec ' + sec.section_number %> &mdash; <%= sec.section_title %>
                          </a>
                        </div>
                      </div>
                      <div class="d-flex justify-content-between align-items-center pt-1 mt-1 border-top" style="font-size: 0.74rem;">
                        <span class="text-muted"><%= sec.legal_nature %></span>
                        <a href="/legal/sections/<%= sec.id %>" class="fw-semibold text-primary text-decoration-none">Read &rarr;</a>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border shadow-sm h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
              <h3 class="h6 fw-bold mb-0">Subject-Matter Taxonomy</h3>
              <a href="/legal/categories" class="small fw-semibold text-primary text-decoration-none">All <%= (categories || []).length %> Topics &rarr;</a>
            </div>
            <div class="card-body p-3">
              <div class="d-flex flex-column gap-2">
                <% (categories || []).slice(0, 6).forEach(function(cat) { %>
                  <a href="/legal/categories/<%= cat.id %>" class="p-2 px-3 border rounded bg-white text-decoration-none text-dark d-flex justify-content-between align-items-center">
                    <div>
                      <div class="fw-bold small text-dark"><%= cat.name %></div>
                      <div class="text-muted" style="font-size: 0.74rem;"><%= cat.domain %></div>
                    </div>
                    <span class="badge bg-light text-primary border fw-semibold"><%= cat.section_count || 0 %> Sections &rarr;</span>
                  </a>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- JIS Case-Law Intelligence Integration Summary (Verified Repository Metrics Only) -->
      <div class="card border shadow-sm bg-light mt-4">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <h3 class="h6 fw-bold mb-1 text-dark">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>JIS Case-Law Intelligence Integration
              </h3>
              <p class="text-muted small mb-0">
                Date-aware statutory cross-referencing connecting judicial dockets to <strong><%= stats.realJudgments %></strong> verified Indian precedents (<%= stats.realSupremeCourtJudgments %> Supreme Court, <%= stats.realHighCourtJudgments %> High Court), <strong><%= stats.verifiedPdfCount || 11 %></strong> verified full-text PDFs, and <strong><%= stats.sections.toLocaleString('en-IN') %></strong> statutory provisions.
              </p>
            </div>
            <a href="/legal/mapping" class="btn btn-sm btn-outline-dark fw-semibold">
              Pre/Post 1 July 2024 Sanhita Transition Matrix &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<%- include('../partials/footer') %>
