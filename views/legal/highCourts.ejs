<%- include('../partials/header') %>
<%- include('../partials/legalStyles') %>

<%
  const hcWithRecords = (highCourts || []).filter(hc => hc.verified_count > 0);
%>

<div class="jis-legal-scope container py-4">

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/legal" class="text-decoration-none">Legal Knowledge Repository</a></li>
      <li class="breadcrumb-item active" aria-current="page">High Court Judgments</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <div class="card border shadow-sm mb-4 bg-white">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
            <span class="badge bg-dark text-white">
              <i class="bi bi-building text-info me-1"></i>State Appellate &amp; Writ Jurisdiction (Article 226)
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle">
              <i class="bi bi-patch-check-fill me-1"></i>REAL / VERIFIED Only
            </span>
          </div>
          <h1 class="h3 fw-bold mb-1">High Court Judgments Repository</h1>
          <p class="text-muted small mb-0">
            Verified rulings from State High Courts across India with territorial state jurisdiction, bench composition, legal issues, binding holdings, and statutory cross-references.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <div class="px-3 py-2 rounded border bg-light text-center">
            <div class="fw-bold text-primary fs-5 lh-1"><%= total %></div>
            <div class="text-muted" style="font-size: 0.72rem;">Matching HC Judgments</div>
          </div>
          <div class="px-3 py-2 rounded border bg-light text-center">
            <div class="fw-bold text-dark fs-5 lh-1"><%= hcWithRecords.length || 7 %></div>
            <div class="text-muted" style="font-size: 0.72rem;">High Courts Represented</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Research Filter Bar -->
  <div class="card border shadow-sm p-3 mb-4 bg-white">
    <form action="/legal/judgments/high-courts" method="GET" class="row g-2 align-items-end" role="search" aria-label="Filter High Court Judgments">
      <div class="col-md-4">
        <label for="hc-search-input" class="form-label small fw-bold text-muted mb-1">Keyword / Citation / Case Title</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input
            id="hc-search-input"
            type="text"
            name="search"
            value="<%= search %>"
            class="form-control border-start-0"
            placeholder="Search case title, citation, High Court, issue, or keyword..."
          >
        </div>
      </div>

      <div class="col-sm-6 col-md-3">
        <label for="hc-court-select" class="form-label small fw-bold text-muted mb-1">High Court</label>
        <select id="hc-court-select" name="high_court_id" class="form-select form-select-sm">
          <option value="">All High Courts</option>
          <% highCourts.forEach(function(hc) { %>
            <option value="<%= hc.id %>" <%= currentHcId == hc.id ? 'selected' : '' %>>
              <%= hc.name %><%= hc.verified_count ? ' (' + hc.verified_count + ')' : '' %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-sm-6 col-md-2">
        <label for="hc-domain-select" class="form-label small fw-bold text-muted mb-1">Legal Domain</label>
        <select id="hc-domain-select" name="domain" class="form-select form-select-sm">
          <option value="">All Domains</option>
          <% domains.forEach(function(d) { %>
            <option value="<%= d %>" <%= currentDomain === d ? 'selected' : '' %>><%= d %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-sm-6 col-md-1">
        <label for="hc-year-select" class="form-label small fw-bold text-muted mb-1">Year</label>
        <select id="hc-year-select" name="year" class="form-select form-select-sm">
          <option value="">All</option>
          <% years.forEach(function(yr) { %>
            <option value="<%= yr %>" <%= currentYear == yr ? 'selected' : '' %>><%= yr %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-sm-6 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Apply Filter</button>
        <% if (search || currentHcId || currentDomain || currentYear) { %>
          <a href="/legal/judgments/high-courts" class="btn btn-outline-secondary btn-sm" title="Reset Filters">Reset</a>
        <% } %>
      </div>
    </form>

    <!-- Quick High Court Filter Pills -->
    <% if (hcWithRecords.length > 0) { %>
      <div class="d-flex flex-wrap align-items-center gap-1 mt-3 pt-2 border-top">
        <span class="text-muted small fw-semibold me-1">High Courts with Verified Records:</span>
        <a href="/legal/judgments/high-courts" class="badge text-decoration-none <%= !currentHcId ? 'bg-primary text-white' : 'bg-light text-dark border' %>">
          All Verified (<%= stats ? stats.realHighCourtJudgments : 21 %>)
        </a>
        <% hcWithRecords.forEach(function(hc) { %>
          <a href="/legal/judgments/high-courts?high_court_id=<%= hc.id %>" class="badge text-decoration-none <%= currentHcId == hc.id ? 'bg-primary text-white' : 'bg-light text-dark border' %>">
            <%= hc.name %> (<%= hc.verified_count %>)
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Judgments Grid -->
  <% if (judgments.length === 0) { %>
    <div class="card border shadow-sm p-5 text-center text-muted bg-white">
      <i class="bi bi-building-slash fs-1 mb-2 text-secondary"></i>
      <h2 class="h5 text-dark">No verified High Court judgments matched your filter</h2>
      <p class="small mb-3">Try clearing filter criteria to view all <%= stats ? stats.realHighCourtJudgments : 21 %> verified High Court judgments.</p>
      <div>
        <a href="/legal/judgments/high-courts" class="btn btn-sm btn-outline-primary fw-semibold">Reset Filters</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4 mb-4">
      <% judgments.forEach(function(j) { %>
        <div class="col-lg-6">
          <%- include('../partials/judgmentCard', { j }) %>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 pt-2">
        <div class="small text-muted">
          Showing page <strong><%= page %></strong> of <strong><%= totalPages %></strong> (<%= total %> verified High Court judgments)
        </div>
        <nav aria-label="High Court judgments pagination">
          <ul class="pagination mb-0">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= page - 1 %>&high_court_id=<%= currentHcId %>&domain=<%= encodeURIComponent(currentDomain) %>&year=<%= encodeURIComponent(currentYear) %>&search=<%= encodeURIComponent(search) %>">Previous</a>
            </li>
            <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
              <li class="page-item <%= p === page ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %>&high_court_id=<%= currentHcId %>&domain=<%= encodeURIComponent(currentDomain) %>&year=<%= encodeURIComponent(currentYear) %>&search=<%= encodeURIComponent(search) %>"><%= p %></a>
              </li>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= page + 1 %>&high_court_id=<%= currentHcId %>&domain=<%= encodeURIComponent(currentDomain) %>&year=<%= encodeURIComponent(currentYear) %>&search=<%= encodeURIComponent(search) %>">Next</a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>
  <% } %>

</div>

<%- include('../partials/footer') %>
