<%- include('../partials/header') %>

<div class="container py-4">

  <!-- Header -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-2">
      <li class="breadcrumb-item"><a href="/legal" class="text-decoration-none">Legal Repository</a></li>
      <li class="breadcrumb-item"><a href="/legal/categories" class="text-decoration-none">Legal Taxonomy</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= category.name %></li>
    </ol>
  </nav>

  <div class="card border-0 shadow-sm p-4 mb-4 bg-light">
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="badge bg-success fs-6 px-3 py-1"><%= category.domain %></span>
      <span class="badge bg-dark"><%= category.code %></span>
    </div>
    <h2 class="fw-bold text-dark mb-1"><%= category.name %></h2>
    <p class="text-secondary small mb-0"><%= category.description %></p>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0">Statutory Provisions Categorized Under This Domain (<%= sections.length %>)</h5>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 25%;">Act & Section</th>
            <th style="width: 45%;">Section Title</th>
            <th style="width: 15%;">Status</th>
            <th style="width: 15%;" class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (sections.length === 0) { %>
            <tr>
              <td colspan="4" class="text-center text-muted py-4">No sections categorized in this group.</td>
            </tr>
          <% } else { %>
            <% sections.forEach(function(sec) { %>
              <tr>
                <td>
                  <span class="badge bg-primary me-1">Sec <%= sec.section_number %></span>
                  <span class="small fw-semibold text-dark"><%= sec.act_short_title %></span>
                </td>
                <td>
                  <a href="/legal/sections/<%= sec.id %>" class="text-decoration-none text-dark hover-primary fw-medium">
                    <%= sec.section_title %>
                  </a>
                </td>
                <td>
                  <span class="badge <%= sec.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                    <%= sec.status %>
                  </span>
                </td>
                <td class="text-end">
                  <a href="/legal/sections/<%= sec.id %>" class="btn btn-sm btn-outline-primary">
                    View Provision
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
