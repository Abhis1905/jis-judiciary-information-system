<%- include('../partials/header') %>
<%- include('../partials/legalStyles') %>

<%
  const hasRealBench = Boolean(
    judgment.bench_judges &&
    !judgment.bench_judges.includes('Bench of the') &&
    !judgment.bench_judges.includes('Division / Single Bench') &&
    !judgment.bench_judges.includes('Presiding')
  );
  const formattedDate = judgment.judgment_date
    ? new Date(judgment.judgment_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })
    : 'Not Specified';
  const linkedSecs = (typeof discussedSections !== 'undefined' && discussedSections && discussedSections.length > 0)
    ? discussedSections
    : (judgment.linked_sections || []);
  const relatedJudgments = judgment.related_judgments || [];
  const primaryDoc = judgment.primaryDocument || null;
  const issueItems = (judgment.legal_issue || '')
    .split(/\s*;\s*|\n+/)
    .map(s => s.trim())
    .filter(Boolean);
  const keywordList = judgment.keywords
    ? judgment.keywords.split(',').map(k => k.trim()).filter(Boolean)
    : [];
  const courtDisplay = judgment.high_court_name || judgment.court_name || judgment.court_tier;
  const pdfSizeFormatted = primaryDoc && primaryDoc.file_size_bytes
    ? (primaryDoc.file_size_bytes >= 1048576
        ? (primaryDoc.file_size_bytes / 1048576).toFixed(2) + ' MB'
        : Math.round(primaryDoc.file_size_bytes / 1024) + ' KB')
    : '';
  const parallelCitations = Array.isArray(judgment.citations) ? judgment.citations : [];
%>

<div class="jis-legal-scope container py-4">

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/legal" class="text-decoration-none">Legal Knowledge Repository</a></li>
      <% if (judgment.court_tier === 'Supreme Court of India') { %>
        <li class="breadcrumb-item"><a href="/legal/judgments/supreme-court" class="text-decoration-none">Supreme Court Judgments</a></li>
      <% } else if (judgment.court_tier === 'High Court') { %>
        <li class="breadcrumb-item"><a href="/legal/judgments/high-courts" class="text-decoration-none">High Court Judgments</a></li>
      <% } %>
      <li class="breadcrumb-item active" aria-current="page"><%= judgment.case_name %></li>
    </ol>
  </nav>

  <!-- Structured Judicial Research Container -->
  <article class="card border shadow-sm mb-4 bg-white">

    <!-- HEADER: Case Title, Court, Date, Citation / Case Number, Bench & Primary Document Action -->
    <header class="card-header bg-white p-4 p-lg-5 border-bottom">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold">
            <i class="bi bi-patch-check-fill me-1"></i>REAL / VERIFIED
          </span>
          <span class="badge bg-dark text-white px-2 py-1 fw-semibold">
            <i class="bi <%= judgment.court_tier === 'Supreme Court of India' ? 'bi-award-fill text-warning' : 'bi-building text-info' %> me-1"></i><%= courtDisplay %>
          </span>
          <% if (judgment.hc_jurisdiction_states) { %>
            <span class="badge bg-light text-secondary border px-2 py-1 fw-medium">
              <i class="bi bi-geo-alt text-primary me-1"></i><%= judgment.hc_jurisdiction_states %>
            </span>
          <% } %>
          <% if (judgment.domain) { %>
            <span class="badge bg-light text-dark border px-2 py-1 fw-semibold"><%= judgment.domain %></span>
          <% } %>
          <% if (primaryDoc) { %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-semibold">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i>Verified PDF Available<%= pdfSizeFormatted ? ' (' + pdfSizeFormatted + ')' : '' %>
            </span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fw-medium">
              <i class="bi bi-file-earmark-text me-1"></i>PDF Currently Unavailable
            </span>
          <% } %>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <% if (primaryDoc) { %>
            <a href="/legal/judgments/<%= judgment.id %>/pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm fw-semibold px-3">
              <i class="bi bi-file-earmark-pdf me-1"></i>Read Judgment PDF
            </a>
            <a href="/legal/judgments/<%= judgment.id %>/pdf?download=1" class="btn btn-outline-dark btn-sm fw-semibold">
              <i class="bi bi-download me-1"></i>Download PDF
            </a>
          <% } %>
          <% if (judgment.source_url) { %>
            <a href="<%= judgment.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
              Official Source <i class="bi bi-box-arrow-up-right ms-1"></i>
            </a>
          <% } %>
        </div>
      </div>

      <h1 class="h2 fw-bold text-dark mb-3" style="line-height: 1.3;"><%= judgment.case_name %></h1>

      <!-- Header Metadata Strip -->
      <div class="jis-kv-grid mb-3">
        <div class="jis-kv-item">
          <div class="jis-kv-label">Court</div>
          <div class="jis-kv-value">
            <%= courtDisplay %>
            <% if (judgment.bench_name) { %> (<%= judgment.bench_name %>)<% } else if (judgment.principal_seat_city) { %> (<%= judgment.principal_seat_city %>)<% } %>
          </div>
        </div>

        <div class="jis-kv-item">
          <div class="jis-kv-label">Judgment Date</div>
          <div class="jis-kv-value"><%= formattedDate %></div>
        </div>

        <div class="jis-kv-item">
          <div class="jis-kv-label">Citation<%= judgment.case_number ? ' & Case Number' : '' %></div>
          <div class="jis-kv-value">
            <span class="text-primary font-monospace"><%= judgment.citation %></span>
            <% if (judgment.neutral_citation && judgment.neutral_citation !== judgment.citation) { %>
              <span class="text-muted fw-normal"> &middot; <%= judgment.neutral_citation %></span>
            <% } %>
            <% if (judgment.case_number) { %>
              <span class="text-secondary fw-normal"> &middot; <%= judgment.case_number %></span>
            <% } %>
          </div>
        </div>

        <div class="jis-kv-item">
          <div class="jis-kv-label">Bench<%= judgment.bench_strength ? ' (' + judgment.bench_strength + ' Judges)' : '' %></div>
          <div class="jis-kv-value">
            <% if (hasRealBench) { %>
              <%= judgment.bench_judges %>
            <% } else if (judgment.bench_strength) { %>
              <%= judgment.bench_strength %>-Judge Bench
            <% } else { %>
              Constitutional / Appellate Bench
            <% } %>
          </div>
        </div>
      </div>

      <!-- In-Page Research Section Navigation -->
      <nav aria-label="Judgment research sections" class="d-flex flex-wrap gap-2 pt-2">
        <a href="#section-overview" class="btn btn-xs btn-light border small py-1 px-2 fw-semibold">1. Case Overview</a>
        <a href="#section-findings" class="btn btn-xs btn-light border small py-1 px-2 fw-semibold">2. Key Findings</a>
        <a href="#section-info" class="btn btn-xs btn-light border small py-1 px-2 fw-semibold">3. Judgment Information</a>
        <a href="#section-related" class="btn btn-xs btn-light border small py-1 px-2 fw-semibold">4. Related Legal Material</a>
        <a href="#section-document" class="btn btn-xs btn-light border small py-1 px-2 fw-semibold">5. Judgment Document</a>
      </nav>
    </header>

    <div class="card-body p-4 p-lg-5">

      <!-- =================================================================
           SECTION 1 — CASE OVERVIEW
           - factual summary
           - legal issue
           - relevant laws / sections
           - keywords
           ================================================================= -->
      <section id="section-overview" class="jis-research-section" aria-labelledby="heading-sec-1">
        <div class="jis-research-sec-header">
          <h2 id="heading-sec-1" class="jis-research-sec-title">
            <span class="jis-research-sec-num">Section 1</span>
            <span>Case Overview</span>
          </h2>
          <span class="small text-muted">Factual Background, Questions of Law &amp; Applicable Statutes</span>
        </div>

        <div class="d-flex flex-column gap-4">
          <!-- Factual Summary (only shown when verified factual summary exists in DB) -->
          <% if (judgment.factual_summary) { %>
            <div class="jis-field-block">
              <div class="jis-field-label">
                <i class="bi bi-file-text text-primary"></i>Factual Summary
              </div>
              <p class="jis-prose-block mb-0"><%= judgment.factual_summary %></p>
            </div>
          <% } %>

          <!-- Legal Issue (structured list only if genuinely multiple issues; single paragraph if 1 sentence) -->
          <% if (issueItems.length > 0) { %>
            <div class="jis-field-block">
              <div class="jis-field-label">
                <i class="bi bi-question-diamond-fill text-primary"></i>Legal Issue<%= issueItems.length > 1 ? 's' : '' %>
              </div>
              <% if (issueItems.length > 1) { %>
                <ol class="jis-prose-block mb-0 ps-3">
                  <% issueItems.forEach(function(issue) { %>
                    <li class="mb-2"><%= issue %></li>
                  <% }); %>
                </ol>
              <% } else { %>
                <p class="jis-prose-block mb-0"><%= issueItems[0] %></p>
              <% } %>
            </div>
          <% } %>

          <!-- Relevant Laws / Sections Summary -->
          <% if (linkedSecs.length > 0) { %>
            <div class="jis-field-block">
              <div class="jis-field-label">
                <i class="bi bi-book text-primary"></i>Relevant Laws &amp; Statutory Sections (<%= linkedSecs.length %>)
              </div>
              <div class="d-flex flex-wrap gap-2 mt-1">
                <% linkedSecs.forEach(function(sec) { %>
                  <a href="/legal/sections/<%= sec.section_id %>" class="btn btn-sm btn-light border text-start py-1 px-2">
                    <span class="fw-bold text-primary"><%= sec.act_short_title || sec.act_title || sec.act_code %></span>
                    <span class="text-dark fw-semibold ms-1">
                      <%= sec.act_code === 'CONST_1950' ? sec.section_number : 'Sec ' + sec.section_number %>
                    </span>
                    <span class="text-muted small ms-1">(<%= sec.section_title %>)</span>
                  </a>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Keywords -->
          <% if (keywordList.length > 0) { %>
            <div class="jis-field-block">
              <div class="jis-field-label">
                <i class="bi bi-tags text-primary"></i>Keywords &amp; Subject Descriptors
              </div>
              <div class="d-flex flex-wrap gap-1 mt-1">
                <% keywordList.forEach(function(kw) { %>
                  <a href="/legal/search?q=<%= encodeURIComponent(kw) %>" class="jis-keyword-pill"><%= kw %></a>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- =================================================================
           SECTION 2 — KEY FINDINGS
           - key ratio
           - key holding
           - important findings (outcome, court reasoning & party arguments where available)
           ================================================================= -->
      <section id="section-findings" class="jis-research-section" aria-labelledby="heading-sec-2">
        <div class="jis-research-sec-header">
          <h2 id="heading-sec-2" class="jis-research-sec-title">
            <span class="jis-research-sec-num">Section 2</span>
            <span>Key Findings &amp; Ratio Decidendi</span>
          </h2>
          <span class="small text-muted">Binding Legal Principle, Operative Holding &amp; Judicial Analysis</span>
        </div>

        <div class="d-flex flex-column gap-3">
          <!-- Key Ratio (Ratio Decidendi) -->
          <% if (judgment.key_ratio) { %>
            <div class="p-4 rounded-3 bg-primary bg-opacity-10 border-start border-4 border-primary">
              <div class="jis-field-label text-primary mb-1">
                <i class="bi bi-quote"></i>Key Ratio (Ratio Decidendi)
              </div>
              <p class="jis-prose-block fw-medium text-dark mb-0"><%= judgment.key_ratio %></p>
            </div>
          <% } %>

          <!-- Key Holding -->
          <% if (judgment.key_holding) { %>
            <div class="p-3 px-4 rounded-3 bg-light border">
              <div class="jis-field-label text-dark mb-1">
                <i class="bi bi-bank2 text-primary"></i>Key Holding
              </div>
              <p class="jis-prose-block mb-0"><%= judgment.key_holding %></p>
            </div>
          <% } %>

          <!-- Important Findings: Court Reasoning (when present in DB) -->
          <% if (judgment.court_reasoning) { %>
            <div class="p-3 px-4 rounded-3 border bg-white">
              <div class="jis-field-label text-dark mb-1">
                <i class="bi bi-journal-check text-primary"></i>Important Findings &amp; Court's Reasoning
              </div>
              <p class="jis-prose-block mb-0"><%= judgment.court_reasoning %></p>
            </div>
          <% } %>

          <!-- Collapsible Arguments Advanced by Parties (only when verified arguments exist in DB) -->
          <% if (judgment.petitioner_arguments || judgment.respondent_arguments) { %>
            <details class="jis-expand-details p-3" open>
              <summary class="jis-expand-summary">
                <span>
                  <i class="bi bi-people-fill text-primary me-1"></i>
                  Submissions &amp; Arguments Advanced by Parties
                </span>
                <i class="bi bi-chevron-down jis-expand-chevron"></i>
              </summary>
              <div class="row g-3 pt-2">
                <% if (judgment.petitioner_arguments) { %>
                  <div class="col-md-6">
                    <div class="p-3 rounded border bg-white h-100">
                      <div class="jis-field-label text-primary">Petitioner / Appellant Submissions</div>
                      <p class="small text-secondary mb-0" style="line-height: 1.6;"><%= judgment.petitioner_arguments %></p>
                    </div>
                  </div>
                <% } %>
                <% if (judgment.respondent_arguments) { %>
                  <div class="col-md-6">
                    <div class="p-3 rounded border bg-white h-100">
                      <div class="jis-field-label text-dark">Respondent / State Submissions</div>
                      <p class="small text-secondary mb-0" style="line-height: 1.6;"><%= judgment.respondent_arguments %></p>
                    </div>
                  </div>
                <% } %>
              </div>
            </details>
          <% } %>

          <!-- Final Outcome / Disposition -->
          <% if (judgment.outcome) { %>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 px-4 rounded-3 bg-light border">
              <div>
                <div class="jis-field-label mb-1">Final Disposition / Order of the Court</div>
                <div class="fw-bold text-dark"><%= judgment.outcome %></div>
              </div>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                <i class="bi bi-check-circle-fill me-1"></i><%= judgment.outcome %>
              </span>
            </div>
          <% } %>
        </div>
      </section>

      <!-- =================================================================
           SECTION 3 — JUDGMENT INFORMATION
           - judgment date
           - court
           - bench
           - case identifier
           - source/provenance where appropriate
           ================================================================= -->
      <section id="section-info" class="jis-research-section" aria-labelledby="heading-sec-3">
        <div class="jis-research-sec-header">
          <h2 id="heading-sec-3" class="jis-research-sec-title">
            <span class="jis-research-sec-num">Section 3</span>
            <span>Judgment Information</span>
          </h2>
          <span class="small text-muted">Institutional Metadata, Identifiers &amp; Record Provenance</span>
        </div>

        <div class="jis-kv-grid">
          <div class="jis-kv-item">
            <div class="jis-kv-label">Judgment Date</div>
            <div class="jis-kv-value"><%= formattedDate %></div>
          </div>

          <div class="jis-kv-item">
            <div class="jis-kv-label">Court &amp; Judicial Tier</div>
            <div class="jis-kv-value">
              <%= courtDisplay %> (<%= judgment.court_tier %>)
            </div>
          </div>

          <% if (judgment.hc_jurisdiction_states) { %>
            <div class="jis-kv-item">
              <div class="jis-kv-label">Territorial State / UT Jurisdiction</div>
              <div class="jis-kv-value"><%= judgment.hc_jurisdiction_states %></div>
            </div>
          <% } %>

          <% if (judgment.bench_name || judgment.principal_seat_city) { %>
            <div class="jis-kv-item">
              <div class="jis-kv-label">Seat / Bench Location</div>
              <div class="jis-kv-value">
                <%= judgment.bench_name || ('Principal Seat at ' + judgment.principal_seat_city) %>
              </div>
            </div>
          <% } %>

          <div class="jis-kv-item">
            <div class="jis-kv-label">Coram / Bench Composition</div>
            <div class="jis-kv-value">
              <% if (hasRealBench) { %>
                <%= judgment.bench_judges %><%= judgment.bench_strength ? ' (' + judgment.bench_strength + '-Judge Bench)' : '' %>
              <% } else if (judgment.bench_strength) { %>
                <%= judgment.bench_strength %>-Judge Bench
              <% } else { %>
                Not Individually Specified in Summary Record
              <% } %>
            </div>
          </div>

          <div class="jis-kv-item">
            <div class="jis-kv-label">Case Identifier &amp; Citations</div>
            <div class="jis-kv-value">
              <% if (judgment.case_number) { %>
                <div><strong>Case No:</strong> <%= judgment.case_number %></div>
              <% } %>
              <div><strong>Primary Citation:</strong> <span class="font-monospace text-primary"><%= judgment.citation %></span></div>
              <% if (judgment.neutral_citation && judgment.neutral_citation !== judgment.citation) { %>
                <div><strong>Neutral Citation:</strong> <span class="font-monospace"><%= judgment.neutral_citation %></span></div>
              <% } %>
              <% if (parallelCitations.length > 0) { %>
                <div class="small text-secondary mt-1">
                  <strong>Reporter Citations:</strong>
                  <%= parallelCitations.map(c => c.reporter_name + ': ' + c.citation_value).join(' | ') %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="jis-kv-item">
            <div class="jis-kv-label">Legal Category / Subject Domain</div>
            <div class="jis-kv-value"><%= judgment.domain %></div>
          </div>

          <div class="jis-kv-item">
            <div class="jis-kv-label">Record Provenance &amp; Custodian Source</div>
            <div class="jis-kv-value">
              <span class="badge bg-success-subtle text-success border border-success-subtle me-1">REAL_VERIFIED</span>
              <span><%= judgment.source_name || 'Official Judicial Repository' %></span>
              <% if (judgment.source_url) { %>
                &middot;
                <a href="<%= judgment.source_url %>" target="_blank" rel="noopener noreferrer" class="small text-primary text-decoration-none">
                  External Custodian Portal <i class="bi bi-box-arrow-up-right"></i>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           SECTION 4 — RELATED LEGAL MATERIAL
           - related verified judgments only
           - related acts/sections where already supported by the existing data
           ================================================================= -->
      <section id="section-related" class="jis-research-section" aria-labelledby="heading-sec-4">
        <div class="jis-research-sec-header">
          <h2 id="heading-sec-4" class="jis-research-sec-title">
            <span class="jis-research-sec-num">Section 4</span>
            <span>Related Legal Material</span>
          </h2>
          <span class="small text-muted">Linked Statutory Provisions &amp; Related Verified Precedents</span>
        </div>

        <!-- 4A. Related Acts & Statutory Sections -->
        <div class="mb-4">
          <h3 class="h6 fw-bold text-dark mb-2">
            <i class="bi bi-journal-code text-primary me-1"></i>Related Acts &amp; Statutory Sections (<%= linkedSecs.length %>)
          </h3>
          <% if (linkedSecs.length === 0) { %>
            <div class="p-3 rounded border bg-light text-muted small">
              No specific statutory sections are directly linked to this judgment record in the database.
            </div>
          <% } else { %>
            <div class="table-responsive border rounded">
              <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                  <tr>
                    <th>Act / Code</th>
                    <th>Provision</th>
                    <th>Section Title</th>
                    <th>Relevance in Judgment</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% linkedSecs.forEach(function(sec) { %>
                    <tr>
                      <td class="fw-semibold">
                        <% if (sec.act_id || sec.act_code) { %>
                          <a href="/legal/acts/<%= sec.act_id || sec.act_code %>" class="text-decoration-none text-dark">
                            <%= sec.act_short_title || sec.act_title || sec.act_code %>
                          </a>
                        <% } else { %>
                          <%= sec.act_short_title || sec.act_title || sec.act_code %>
                        <% } %>
                      </td>
                      <td class="fw-bold text-primary">
                        <%= sec.act_code === 'CONST_1950' ? sec.section_number : 'Section ' + sec.section_number %>
                      </td>
                      <td>
                        <a href="/legal/sections/<%= sec.section_id %>" class="text-decoration-none text-dark fw-medium">
                          <%= sec.section_title %>
                        </a>
                      </td>
                      <td>
                        <span class="badge bg-light text-secondary border">
                          <%= sec.relevance_nature || 'Interpreted & Applied' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/legal/sections/<%= sec.section_id %>" class="btn btn-sm btn-outline-primary py-0 px-2">
                          View Section &rarr;
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <!-- 4B. Related Verified Judgments (REAL_VERIFIED only) -->
        <div>
          <h3 class="h6 fw-bold text-dark mb-2">
            <i class="bi bi-diagram-2 text-primary me-1"></i>Related Verified Judgments (<%= relatedJudgments.length %>)
          </h3>
          <% if (relatedJudgments.length === 0) { %>
            <div class="p-3 rounded border bg-light text-muted small">
              No additional related verified judgments found in this domain.
            </div>
          <% } else { %>
            <div class="row g-3">
              <% relatedJudgments.forEach(function(rel) { %>
                <div class="col-md-6">
                  <div class="p-3 border rounded-3 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                      <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-2 small">
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                          <span class="badge bg-dark text-white"><%= rel.court_name || rel.court_tier %></span>
                          <span class="badge bg-light text-dark border"><%= new Date(rel.judgment_date).getFullYear() %></span>
                        </div>
                        <% if (rel.has_verified_pdf) { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>PDF Available
                          </span>
                        <% } %>
                      </div>

                      <h4 class="h6 fw-bold mb-1">
                        <a href="/legal/judgments/<%= rel.id %>" class="text-decoration-none text-dark">
                          <%= rel.case_name %>
                        </a>
                      </h4>

                      <div class="small text-primary font-monospace fw-semibold mb-2">
                        <%= rel.citation %>
                        <% if (rel.domain) { %>
                          <span class="text-muted font-sans fw-normal"> &middot; <%= rel.domain %></span>
                        <% } %>
                      </div>

                      <% if (rel.legal_issue) { %>
                        <div class="mb-2">
                          <span class="jis-field-label" style="font-size: 0.66rem;">Issue</span>
                          <p class="small text-secondary mb-0" style="line-height: 1.45;"><%= rel.legal_issue %></p>
                        </div>
                      <% } %>

                      <% if (rel.key_holding || rel.key_ratio) { %>
                        <div class="p-2 rounded bg-light border-start border-2 border-primary">
                          <span class="jis-field-label text-primary" style="font-size: 0.66rem;">Key Holding</span>
                          <p class="small text-dark mb-0" style="line-height: 1.45;"><%= rel.key_holding || rel.key_ratio %></p>
                        </div>
                      <% } %>
                    </div>

                    <div class="pt-2 mt-3 border-top d-flex justify-content-between align-items-center small">
                      <a href="/legal/judgments/<%= rel.id %>" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold">
                        View Judgment &rarr;
                      </a>
                      <% if (rel.has_verified_pdf) { %>
                        <a href="/legal/judgments/<%= rel.id %>/pdf" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark py-0 px-2">
                          <i class="bi bi-file-earmark-pdf text-danger me-1"></i>Read PDF
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>

      <!-- SECTION 5 — JUDGMENT DOCUMENT -->
      <section id="section-document" class="jis-research-section" aria-labelledby="heading-sec-5">
        <div class="jis-research-sec-header">
          <h2 id="heading-sec-5" class="jis-research-sec-title">
            <span class="jis-research-sec-num">Section 5</span>
            <span>Judgment Document</span>
          </h2>
          <span class="small text-muted">Full-Text Judicial Opinion &amp; Checksum Verification</span>
        </div>

        <% if (primaryDoc) { %>
          <div class="p-4 rounded-3 border bg-light">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 pb-3 mb-3 border-bottom">
              <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                  <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                  <h3 class="h5 fw-bold text-dark mb-0">Verified Full-Text Judgment PDF</h3>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-shield-check me-1"></i>Verified Official Copy
                  </span>
                </div>
                <p class="small text-secondary mb-0">
                  Authentic full-text judgment PDF archived from <strong><%= primaryDoc.source_name %></strong> and verified against this record.
                </p>
              </div>

              <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                <a href="/legal/judgments/<%= judgment.id %>/pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary fw-semibold px-4">
                  <i class="bi bi-file-earmark-pdf me-1"></i>Read Judgment PDF
                </a>
                <a href="/legal/judgments/<%= judgment.id %>/pdf?download=1" class="btn btn-outline-dark fw-semibold px-3">
                  <i class="bi bi-download me-1"></i>Download PDF
                </a>
              </div>
            </div>

            <!-- Document Metadata Grid -->
            <div class="jis-kv-grid bg-white">
              <div class="jis-kv-item">
                <div class="jis-kv-label">Document Type</div>
                <div class="jis-kv-value"><%= primaryDoc.document_type || 'SIGNED_JUDGMENT_PDF' %></div>
              </div>
              <div class="jis-kv-item">
                <div class="jis-kv-label">File Size</div>
                <div class="jis-kv-value"><%= pdfSizeFormatted || 'Verified PDF' %> (<%= (primaryDoc.file_size_bytes || 0).toLocaleString('en-IN') %> bytes)</div>
              </div>
              <div class="jis-kv-item">
                <div class="jis-kv-label">Archived Filename</div>
                <div class="jis-kv-value font-monospace small"><%= primaryDoc.original_filename %></div>
              </div>
              <div class="jis-kv-item">
                <div class="jis-kv-label">Custodian Source</div>
                <div class="jis-kv-value"><%= primaryDoc.source_name %></div>
              </div>
              <% if (primaryDoc.checksum) { %>
                <div class="jis-kv-item" style="grid-column: 1 / -1;">
                  <div class="jis-kv-label">SHA-256 Integrity Checksum</div>
                  <div class="jis-kv-value font-monospace small text-secondary"><%= primaryDoc.checksum %></div>
                </div>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <div class="p-4 rounded-3 border bg-light d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                  <i class="bi bi-file-earmark-excel me-1"></i>PDF currently unavailable
                </span>
                <span class="fw-bold text-dark">Full-Text PDF Not Locally Archived</span>
              </div>
              <p class="small text-muted mb-0">
                PDF currently unavailable on the local JIS repository server for this verified judgment record. All structured legal research metadata, ratio decidendi, and statutory links above are verified.
              </p>
            </div>
            <% if (judgment.source_url) { %>
              <a href="<%= judgment.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm fw-semibold flex-shrink-0">
                Consult Official Source (<%= judgment.source_name || 'Custodian Portal' %>) <i class="bi bi-box-arrow-up-right ms-1"></i>
              </a>
            <% } %>
          </div>
        <% } %>
      </section>

      <!-- Collapsible Docket Cross-Reference (Preserves reverse case navigation without cluttering judicial research view) -->
      <details class="mt-4 pt-3 border-top">
        <summary class="small fw-semibold text-muted" style="cursor: pointer;">
          JIS Cases Referencing This Precedent (<%= typeof casePagination !== 'undefined' && casePagination ? casePagination.total.toLocaleString('en-IN') : 0 %> synthetic docket records)
        </summary>
        <div class="mt-3">
          <% if (typeof casePagination !== 'undefined' && casePagination && casePagination.cases.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle mb-0 border small">
                <thead class="table-light">
                  <tr>
                    <th>Case Number</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Relevance</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% casePagination.cases.forEach(function(c) { %>
                    <tr>
                      <td>
                        <code class="text-dark"><%= c.case_number %></code>
                        <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size: 0.65rem;">SYNTHETIC JIS CASE</span>
                      </td>
                      <td><%= c.title %></td>
                      <td><%= c.status %></td>
                      <td><span class="badge bg-light text-dark border"><%= c.relevance_type %></span></td>
                      <td class="text-end">
                        <% if (c.is_public) { %>
                          <a href="/case/<%= c.id %>" class="btn btn-sm btn-outline-secondary py-0">View</a>
                        <% } else { %>
                          <span class="text-muted">Private</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="small text-muted mb-0">No JIS docket cases currently linked to this precedent.</p>
          <% } %>
        </div>
      </details>

    </div>
  </article>

</div>

<%- include('../partials/footer') %>
